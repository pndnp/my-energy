{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "prisma": "prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "fix": "biome format --write src/"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "@types/node": "26.2.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "openai": "4.98.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "prisma": "6.18.0",
    "tsc-alias": "1.8.16",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
